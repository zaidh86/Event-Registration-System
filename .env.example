# Copy this file to .env and adjust the values for your environment.

# Security — generate a strong unique value for every environment.
SECRET_KEY=insecure-dev-key-change-me

# Debug mode. Never enable in production.
DEBUG=True

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection.
DB_NAME=event_registration
DB_USER=event_registration
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=

# Throttle rates (DRF format: <number>/<second|minute|hour|day>).
THROTTLE_ANON=100/minute
THROTTLE_USER=1000/minute
THROTTLE_AUTH=10/minute

# Logging.
LOG_LEVEL=INFO
